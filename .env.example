# External simulator installation directories (no surrounding quotes).
CARLA_ROOT=
SUMO_HOME=

# Optional override for SUMO's executable; otherwise derived from SUMO_HOME.
SUMO_BINARY=

# Python executable used by the Windows launchers. "python" uses PATH.
PYTHON_EXE=python

# Optional output location and input file for one-off inspection scripts.
ARTIFACT_DIR=output/artifacts
TRANSCRIPT_FILE=
