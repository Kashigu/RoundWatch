<?xml version="1.0" encoding="UTF-8"?>
<!-- RoundWatch: 2-lane roundabout for CARLA + SUMO co-simulation (generated by scripts/build_roundabout_2lane.py) -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="roundabout_2lane.net.xml"/>
        <route-files value="roundabout_2lane.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="300"/>
        <step-length value="0.05"/>
    </time>
    <processing>
        <collision.action value="warn"/>
        <collision.check-junctions value="true"/>
        <time-to-teleport value="-1"/>
    </processing>
    <random_number>
        <seed value="42"/>
    </random_number>
</configuration>
